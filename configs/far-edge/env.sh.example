#!/usr/bin/env bash
# Far-Edge MEC Node Environment — 5G MEC Content Intelligence
# Copy to env.sh and fill in your values. NEVER commit env.sh to Git.

# ── FAR EDGE / MEC NODE ───────────────────────────────────────
export FAR_EDGE_API="https://api.<your-mec-node>:6443"
export FAR_EDGE_TOKEN="<your-serviceaccount-token>"
export FAR_EDGE_SITE_ID="stadium-mec-07"      # unique site identifier
export FAR_EDGE_VENUE_TYPE="stadium"           # stadium | cell-site | enterprise

# ── NAMESPACE ─────────────────────────────────────────────────
export FAR_NS="far-edge-mec"

# ── KSERVE MODELS ─────────────────────────────────────────────
export LSTM_MODEL_PATH="/var/mec-cache/models/lstm-demand"
export LSTM_SERVICE_NAME="lstm-demand-predictor"
export ABR_SERVICE_NAME="abr-policy-engine"

# ── CACHE ─────────────────────────────────────────────────────
export CACHE_STORAGE_PATH="/var/mec-cache/content"
export CACHE_MAX_GB="380"        # leave headroom on 400GB NVMe

# ── KAFKA (connect to near-edge broker) ───────────────────────
export KAFKA_BOOTSTRAP="kafka-cluster-kafka-bootstrap.mec-ai-data.<near-edge-cluster-domain>:443"
export KAFKA_TLS_ENABLED="true"
export KAFKA_SASL_ENABLED="true"

# ── ACM KLUSTERLET ────────────────────────────────────────────
export ACM_HUB_API="https://api.<your-near-edge-cluster>:6443"

# ── NEAR EDGE CLUSTER DOMAIN (for service references) ─────────
export NEAR_EDGE_DOMAIN="apps.<your-near-edge-cluster>"
