#!/usr/bin/env bash
# Near-Edge Cluster Environment — 5G MEC Content Intelligence
# Copy to env.sh and fill in your values. NEVER commit env.sh to Git.
#
# HOW TO USE:
#   cp configs/near-edge/env.sh.example configs/near-edge/env.sh
#   # Edit env.sh with your real values
#   source configs/near-edge/env.sh
#   ./scripts/setup-infra.sh --skip-mec    # bootstraps cluster + GPU node
#   ./scripts/apply-secrets.sh --validate  # check all vars are set
#   ./scripts/apply-secrets.sh             # create/update all secrets
#
# GENERATE SECRETS (run once, save the output into this file):
#   export PG_PASSWORD=$(openssl rand -hex 16)
#   export CH_PASSWORD=$(openssl rand -hex 16)
#   export MINIO_SECRET_KEY=$(openssl rand -hex 16)
#   export LANGFUSE_NEXTAUTH_SECRET=$(openssl rand -hex 32)
#   export LANGFUSE_ENCRYPTION_KEY=$(openssl rand -hex 32)   # ⚠️ NEVER change after first deploy
#   export LANGFUSE_SALT=$(openssl rand -hex 16)             # ⚠️ NEVER change after first deploy

# ── AWS CREDENTIALS (RHDP: copy from sandbox portal → AWS tab) ────────────────
# Required for: GPU spot price selection, MEC SNO provisioning, VPC lookups.
# setup-infra.sh auto-sources this file so these are picked up automatically.
export AWS_ACCESS_KEY_ID="<aws-access-key-id>"
export AWS_SECRET_ACCESS_KEY="<aws-secret-access-key>"
export AWS_DEFAULT_REGION="us-east-2"

# ── NEAR EDGE CLUSTER ─────────────────────────────────────────────────────────
# setup-infra.sh auto-populates OCP_* vars — set NEAR_EDGE_API before first run
export NEAR_EDGE_API="https://api.<your-near-edge-cluster>:6443"
export OCP_API_URL="https://api.<your-near-edge-cluster>:6443"      # same as NEAR_EDGE_API
export OCP_CONSOLE_URL="https://console-openshift-console.apps.<your-near-edge-cluster>"
export OCP_APPS_DOMAIN="apps.<your-near-edge-cluster>"
export INFRA_ID="<cluster-infra-id>"                                 # oc get infrastructure cluster -o jsonpath='{.status.infrastructureName}'
export AWS_REGION="us-east-2"
export KUBECONFIG="${HOME}/mec-rhdp/near-edge-kubeconfig"
export NEAR_EDGE_TOKEN="<your-serviceaccount-token>"
export NEAR_EDGE_CLUSTER_NAME="near-edge"

# ── FAR EDGE MEC NODES ────────────────────────────────────────────────────────
export MEC_01_IP="<set after MEC SNO install>"
export MEC_02_IP="<set after MEC SNO install>"
export MEC_KUBECONFIG_MEC_STADIUM_01="${HOME}/mec-rhdp/mec-stadium-01-kubeconfig"
export MEC_KUBECONFIG_MEC_STADIUM_02="${HOME}/mec-rhdp/mec-stadium-02-kubeconfig"

# ── NAMESPACES ────────────────────────────────────────────────────────────────
export NS_MAIN="mec-content-ai"
export NS_DATA="mec-ai-data"
export NS_OBS="mec-ai-obs"
export NS_RHOAI="redhat-ods-applications"
export NS_AAP="aap"
export NS_ACM="open-cluster-management"
export NS_KAFKA="mec-ai-data"
export NS_GITOPS="openshift-gitops"

# ── RHOAI / vLLM ──────────────────────────────────────────────────────────────
export RHOAI_VERSION="3.3"
export VLLM_MODEL="granite-3-3-8b"
export VLLM_URL="http://granite-3-3-8b-predictor.mec-content-ai.svc.cluster.local"  # Granite 3.3 8B — reasoning + Lightspeed
export LLAMASTACK_URL="http://mec-llamastack.mec-content-ai.svc.cluster.local:8321"

# ── KAFKA ─────────────────────────────────────────────────────────────────────
export KAFKA_BOOTSTRAP="kafka-cluster-kafka-bootstrap.${NS_DATA}.svc.cluster.local:9092"
export KAFKA_BOOTSTRAP_TLS="kafka-cluster-kafka-bootstrap.${NS_DATA}.svc.cluster.local:9093"

# ── MINIO ─────────────────────────────────────────────────────────────────────
export MINIO_ENDPOINT="http://minio.${NS_DATA}.svc.cluster.local:9000"
export MINIO_ACCESS_KEY="mec-minio-admin"
export MINIO_SECRET_KEY="<generate: openssl rand -hex 16>"
export MINIO_BUCKET="mec-models"

# ── LANGFUSE SECRETS (Phase 02 — generate once, never change after deploy) ────
export PG_PASSWORD="<generate: openssl rand -hex 16>"
export CH_PASSWORD="<generate: openssl rand -hex 16>"
export LANGFUSE_NEXTAUTH_SECRET="<generate: openssl rand -hex 32>"
export LANGFUSE_ENCRYPTION_KEY="<generate: openssl rand -hex 32>"   # ⚠️ NEVER change
export LANGFUSE_SALT="<generate: openssl rand -hex 16>"             # ⚠️ NEVER change
export LANGFUSE_HOST="https://langfuse.${OCP_APPS_DOMAIN}"

# ── LANGFUSE API KEYS (Phase 05 — from Langfuse UI after Phase 02 deploy) ─────
# Langfuse UI → Settings → API Keys → Create new key
export LANGFUSE_PUBLIC_KEY="pk-lf-<get-from-langfuse-ui>"
export LANGFUSE_SECRET_KEY="sk-lf-<get-from-langfuse-ui>"

# ── AAP (Phase 04) ────────────────────────────────────────────────────────────
export AAP_HOST="https://controller-aap.${OCP_APPS_DOMAIN}"
export AAP_ADMIN_PASSWORD="<aap-admin-password>"
export AAP_TOKEN="<aap-controller-token>"

# ── SLACK (Phase 05 — human-in-loop approvals) ────────────────────────────────
export SLACK_BOT_TOKEN="xoxb-<your-slack-bot-token>"
export SLACK_SIGNING_SECRET="<your-slack-app-signing-secret>"
export SLACK_WEBHOOK_URL="https://hooks.slack.com/services/<your-webhook>"
export SLACK_NOC_CHANNEL="#mec-ai-ops"
export SLACK_APPROVAL_CHANNEL="#mec-ai-ops"
export SLACK_REPORTS_CHANNEL="#mec-ai-reports"

# ── EDGESTREAM IQ DASHBOARD (Phase 07) ───────────────────────────────────────
export EDGESTREAM_URL="https://edgestream-iq.${OCP_APPS_DOMAIN}"

# ── AGENT (Phase 05) ──────────────────────────────────────────────────────────
export AGENT_URL="http://content-intelligence-agent.${NS_MAIN}.svc.cluster.local:8000"

# ── GIT REPO (for ArgoCD Applications) ───────────────────────────────────────
export GIT_REPO_URL="https://github.com/dinlaks/5g-mec-ai.git"
export GIT_BRANCH="main"
