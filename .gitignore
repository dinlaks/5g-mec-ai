# Environment configs (contain secrets — NEVER commit)
configs/near-edge/env.sh
configs/far-edge/env.sh

# Cluster CA certificates (cluster-specific — NEVER commit)
*.crt
*.ca
configs/*.crt
configs/*.ca

# Secrets and credentials
*.token
*.pem
*.key
pull-secret.json
pull-secret.txt
*-secret-values.yaml
*credentials*

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
dist/
build/
*.egg

# Node / frontend build artifacts
node_modules/
dist/
.next/
*.lock
!package-lock.json

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Editor
.vscode/
.idea/
*.swp
*.swo

# Terraform (if used later)
*.tfstate
*.tfstate.backup
.terraform/

# Temporary / scratch
scratch/
tmp/
*.tmp
*.bak
session-notes/

# Generated rendered YAMLs (keep templates, gitignore rendered if they contain env-specific values)
# Uncomment if using envsubst rendering pattern:
# implementation/**/generated/

# Logs (keep structure, ignore raw log files)
logs/session-notes/
*.log

# SNO / infra install state (generated by setup-infra.sh — contains kubeconfigs + certs)
~/mec-rhdp/

# Claude memory (local only)
memory/

# Frontend build output
implementation/phase-07-dashboard/frontend/dist/
implementation/phase-07-dashboard/frontend/node_modules/

# openshift-install artifacts (contain credentials)
*.openshift_install.log
.openshift_install_state.json
